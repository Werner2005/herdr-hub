{
  "openapi": "3.0.3",
  "info": {
    "title": "Herdr Hub API",
    "version": "0.1.0",
    "description": "Manage Kubernetes workspaces, accounts, API tokens, shared storage and configuration. Use Authorize to enter an API token (without the Bearer prefix). Named API tokens have full admin access as their owner. Browser sessions are also supported. Any supplied Origin header on a mutating request must match the Hub origin. Errors are JSON objects with an error string. Operations may return 400 (invalid input), 401 (authentication required), 403 (permission denied), 404 (not found or not visible), 409 (conflict), 413 (body too large), 429 (login throttled), 500 (database/internal failure), 502 (Kubernetes failure), or 503 (request expired)."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}, {"sessionAuth": []}],
  "tags": [{"name":"Authentication"},{"name":"API tokens"},{"name":"Users"},{"name":"Workspaces"},{"name":"Settings"},{"name":"Shared volumes"},{"name":"Groups"},{"name":"Configurations"},{"name":"Directory"},{"name":"Child workloads"}],
  "paths": {
    "/api/workspaces/{name}/workload-access": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Child workloads"],"summary":"Read child-workload budget (workspace owner or admin)","responses":{"200":{"description":"Budget; disabled defaults if not configured","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildBudget"}}}}}},
      "put":{"tags":["Child workloads"],"summary":"Configure a child-workload budget (admin only)","description":"Default-off feature requires workloads.enabled and enforced NetworkPolicy. Cannot shrink below retained reservations. Disabling revokes the credential and pauses new launches, but does not delete running children or volumes.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildBudget"}}}},"responses":{"200":{"description":"Saved budget","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildBudget"}}}},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workspaces/{name}/workload-token": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "post":{"tags":["Child workloads"],"summary":"Issue or rotate scoped workload credential (workspace owner or admin)","description":"Requires an enabled budget and active owned parent. Revokes the previous credential. Returned once, expires in 24 hours, stored only as a hash. Not valid on normal administrative APIs. Already-open bounded I/O may finish after revocation (at most 30 seconds).","responses":{"201":{"description":"Credential; save in a private file","content":{"application/json":{"schema":{"type":"object","required":["token","expires_at"],"properties":{"token":{"type":"string","pattern":"^hhw_[0-9a-f]{64}$"},"expires_at":{"type":"string","format":"date-time"}}}}}},"409":{"$ref":"#/components/responses/Error"}}},
      "delete":{"tags":["Child workloads"],"summary":"Revoke scoped workload credential (workspace owner or admin)","responses":{"204":{"description":"Revoked"}}}
    },
    "/api/workload/v1/workloads": {
      "get":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"List children of the credential's parent workspace","responses":{"200":{"description":"Children; env values are not returned","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ChildWorkload"}}}}}}},
      "post":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Launch a resource-limited child Pod","description":"Reserves count/CPU/memory/storage before provisioning. Names are unique within the parent. All states retain reservations until confirmed deletion. Commands are argument arrays, not shell strings. Missing named volumes and anonymous volumes reserve 1Gi each. Env values live only in an immutable Kubernetes Secret, never PostgreSQL or GET responses. Child Pods run as UID/GID 1001, without capabilities, privilege escalation or service-account tokens, with finite CPU/memory and 1Gi ephemeral-storage limits. Pods do not restart; lifetime is eight hours. stdin/TTY are rejected. A 502 may retain a reservation: inspect before retrying. Private service ports accept only the parent and sibling workloads; children may access their parent, DNS and allowed public Internet, not parent-specific private-egress exceptions. No public exports. Requires the feature and NetworkPolicy.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildWorkloadSpec"}}}},"responses":{"201":{"description":"Reserved and submitted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildWorkload"}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workload/v1/workloads/{name}": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Inspect a child workload","responses":{"200":{"description":"Child status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildWorkload"}}}},"404":{"$ref":"#/components/responses/Error"}}},
      "delete":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Remove child Pod and anonymous storage","description":"Retains named volumes. Returns 204 only after confirmed Kubernetes deletion. Partial deletion retains reservations and retries in the background.","responses":{"204":{"description":"Cleanup confirmed"},"404":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workload/v1/workloads/{name}/logs": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Read a bounded child log snapshot","description":"Up to 1MiB/10000 lines, 30-second timeout; not log following. Shares a global four-session limit with exec.","responses":{"200":{"description":"Log snapshot","content":{"application/json":{"schema":{"type":"object","required":["logs"],"properties":{"logs":{"type":"string"}}}}}},"429":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workload/v1/workloads/{name}/exec": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "post":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Execute a bounded non-interactive custom command","description":"Uses Kubernetes v4.channel.k8s.io WebSocket exec. No implicit shell, stdin or TTY. Maximum 30-second I/O session, 1MiB aggregate framed output and four concurrent I/O sessions globally. Disconnect/timeout does not guarantee process termination; Pod resource limits and lifetime still apply. Nonzero process exit is a successful HTTP response containing exit_code. Revocation does not interrupt an already-authorized session.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildExecRequest"}}}},"responses":{"200":{"description":"Command result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildExecResult"}}}},"429":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workload/v1/volumes": {
      "get":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"List the parent's named child volumes","responses":{"200":{"description":"Named volumes (anonymous storage is workload-owned)","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ChildVolume"}}}}}}},
      "post":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Reserve and create a named child PVC","description":"Parent-scoped names, finite storage/count budgets, configured workspace StorageClass and RWO access. Once provisioned, a missing PVC is never recreated automatically.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildVolume"}}}},"responses":{"201":{"description":"Reserved and provisioned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildVolume"}}}},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workload/v1/volumes/{name}": {
      "parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Inspect a named child volume","responses":{"200":{"description":"Volume","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChildVolume"}}}},"404":{"$ref":"#/components/responses/Error"}}},
      "delete":{"tags":["Child workloads"],"security":[{"workloadAuth":[]}],"summary":"Delete an unreferenced named child volume","description":"References in any workload state block removal. Reservation is released only after PVC deletion is confirmed.","responses":{"204":{"description":"Deleted"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/healthz": {"get":{"tags":["Settings"],"summary":"Check database health","security":[],"responses":{"200":{"description":"Healthy","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"}}}}}},"503":{"$ref":"#/components/responses/Error"}}}},
    "/api/login": {"post":{"tags":["Authentication"],"summary":"Sign in with username and password","security":[],"requestBody":{"$ref":"#/components/requestBodies/Login"},"responses":{"200":{"description":"Authenticated; sets a 12-hour HttpOnly session cookie","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Identity"}}}},"401":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"}}}},
    "/api/me": {"get":{"tags":["Authentication"],"summary":"Get the authenticated identity","responses":{"200":{"description":"Identity (bootstrap bearer has an empty username)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Identity"}}}},"401":{"$ref":"#/components/responses/Error"}}}},
    "/api/logout": {"post":{"tags":["Authentication"],"summary":"Invalidate the current browser session","description":"Clears the session cookie; does not revoke API tokens.","responses":{"204":{"description":"Signed out"}}}},
    "/api/api-tokens": {
      "get":{"tags":["API tokens"],"summary":"List all token metadata (admin only)","responses":{"200":{"description":"Tokens; never includes plaintext tokens or hashes","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/APIToken"}}}}}}},
      "post":{"tags":["API tokens"],"summary":"Create an API token (admin only)","description":"Owner defaults to the authenticated account. Bootstrap bearer must provide an existing admin username. Tokens do not expire automatically. Deleting or demoting the owner permanently revokes its tokens.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":100},"username":{"type":"string","description":"Existing admin account; defaults to caller"}},"example":{"name":"automation"}}}}},"responses":{"201":{"description":"Token created. Save the token now: it is only returned once.","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/APIToken"},{"type":"object","properties":{"token":{"type":"string","example":"herdr_<64 hex characters>"}}}]}}}},"400":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/api-tokens/{id}": {"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"delete":{"tags":["API tokens"],"summary":"Revoke an API token (admin only)","responses":{"204":{"description":"Revoked"},"404":{"$ref":"#/components/responses/Error"}}}},
    "/api/users": {
      "get":{"tags":["Users"],"summary":"List accounts (admin only)","responses":{"200":{"description":"Accounts","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Identity"}}}}}}},
      "post":{"tags":["Users"],"summary":"Create an account (admin only)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["username","password","role"],"properties":{"username":{"$ref":"#/components/schemas/AccountName"},"password":{"$ref":"#/components/schemas/Password"},"role":{"$ref":"#/components/schemas/Role"}}}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Identity"}}}},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/users/{username}": {"parameters":[{"name":"username","in":"path","required":true,"schema":{"$ref":"#/components/schemas/AccountName"}}],
      "patch":{"tags":["Users"],"summary":"Change role or reset password (admin only)","description":"Supply role and/or password. Cannot demote yourself or the last admin. Password reset invalidates other browser sessions. Demotion revokes API tokens.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","minProperties":1,"properties":{"password":{"$ref":"#/components/schemas/Password"},"role":{"$ref":"#/components/schemas/Role"}}}}}},"responses":{"200":{"description":"Updated identity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Identity"}}}},"409":{"$ref":"#/components/responses/Error"}}},
      "delete":{"tags":["Users"],"summary":"Delete an account (admin only)","description":"Reassign workspaces and remove owned shared volumes, groups and configurations first. Cannot delete yourself or the last admin.","responses":{"204":{"description":"Deleted; sessions and API tokens revoked"},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/config": {
      "get":{"tags":["Settings"],"summary":"Get workspace settings and resource/security defaults","responses":{"200":{"description":"Settings","content":{"application/json":{"schema":{"type":"object"}}}}}},
      "patch":{"tags":["Settings"],"summary":"Update resource defaults or security limits (admin only)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"resource_defaults":{"$ref":"#/components/schemas/Resources"},"security_limits":{"$ref":"#/components/schemas/SecurityLimits"}}}}}},"responses":{"200":{"description":"Updated settings","content":{"application/json":{"schema":{"type":"object"}}}}}}
    },
    "/api/egress-defaults": {
      "get":{"tags":["Settings"],"summary":"Read default outbound rules (all authenticated users)","responses":{"200":{"description":"Defaults for all existing and future workspaces","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EgressSettings"}}}}}},
      "put":{"tags":["Settings"],"summary":"Replace default outbound rules (admin only)","description":"Additive to Helm policies and workspace exceptions. Updates NetworkPolicy only, without restarting pods. A 502 retains desired rules for startup/minutely retry. Edits require networkPolicy.enabled.","requestBody":{"$ref":"#/components/requestBodies/EgressRules"},"responses":{"200":{"description":"Applied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EgressSettings"}}}} ,"403":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workspaces/{name}/egress": {"parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Workspaces"],"summary":"Read workspace outbound exceptions (owner or admin)","responses":{"200":{"description":"Workspace exceptions only; defaults also apply","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EgressSettings"}}}}}},
      "put":{"tags":["Workspaces"],"summary":"Replace workspace outbound exceptions (owner or admin)","description":"Scope is determined by the URL and current workspace ownership. Rules survive undeployment, are cleaned before workspace deletion, and must be removed before ownership transfer. Does not restart pods or change ingress. Rules are additive, not deny rules. A 502 retains desired state for automatic retry.","requestBody":{"$ref":"#/components/requestBodies/EgressRules"},"responses":{"200":{"description":"Applied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EgressSettings"}}}},"404":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workspaces": {
      "get":{"tags":["Workspaces"],"summary":"List visible workspaces","description":"Admins see all; users see their own workspaces.","responses":{"200":{"description":"Workspaces","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Workspace"}}}}}}},
      "post":{"tags":["Workspaces"],"summary":"Create and provision a workspace (admin only)","description":"Reuses a retained home PVC with the same name. At least one OpenSSH public key is required. Attach shared volumes after creation.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","ssh_public_key"],"properties":{"name":{"$ref":"#/components/schemas/ResourceName"},"ssh_public_key":{"type":"string"},"owner":{"$ref":"#/components/schemas/AccountName"},"storage_size":{"$ref":"#/components/schemas/StorageSize"},"resources":{"$ref":"#/components/schemas/Resources"},"configurations":{"type":"array","items":{"$ref":"#/components/schemas/ConfigurationMapping"}}}}}}},"responses":{"201":{"description":"Provisioned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workspaces/{name}": {"parameters":[{"$ref":"#/components/parameters/Name"}],"delete":{"tags":["Workspaces"],"summary":"Delete runtime (owner or admin)","description":"Removes workspace entry and runtime resources but retains its home PVC.","responses":{"204":{"description":"Deleted"}}}},
    "/api/workspaces/{name}/deploy": {"parameters":[{"$ref":"#/components/parameters/Name"}],"post":{"tags":["Workspaces"],"summary":"Deploy a workspace (owner or admin)","responses":{"201":{"description":"Provisioned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}}}}},
    "/api/workspaces/{name}/undeploy": {"parameters":[{"$ref":"#/components/parameters/Name"}],"post":{"tags":["Workspaces"],"summary":"Stop a workspace (owner or admin)","description":"Retains workspace entry, home PVC, credentials and assignments. Disconnects active sessions.","responses":{"200":{"description":"Undeployed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}}}}},
    "/api/workspaces/{name}/retry": {"parameters":[{"$ref":"#/components/parameters/Name"}],"post":{"tags":["Workspaces"],"summary":"Retry create-only provisioning (admin only)","description":"Preserves existing resources and credentials.","responses":{"201":{"description":"Provisioned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Workspace"}}}}}}},
    "/api/workspaces/{name}/owner": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Workspaces"],"summary":"Transfer ownership (admin only)","description":"Stops the workspace, rotates its web token and removes SSH keys. Retained home files are not sanitized.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["owner"],"properties":{"owner":{"$ref":"#/components/schemas/AccountName"}}}}}},"responses":{"200":{"description":"Ownership updated"}}}},
    "/api/workspaces/{name}/size": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Workspaces"],"summary":"Expand home storage (admin only)","requestBody":{"$ref":"#/components/requestBodies/StorageSize"},"responses":{"200":{"description":"Expanded"}}}},
    "/api/workspaces/{name}/ssh-key": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Workspaces"],"summary":"Replace SSH keys (owner or admin)","description":"Restarts a deployed workspace. An empty string disables SSH access.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["ssh_public_key"],"properties":{"ssh_public_key":{"type":"string"}}}}}},"responses":{"200":{"description":"Keys updated"}}}},
    "/api/workspaces/{name}/resources": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Workspaces"],"summary":"Update CPU/memory (owner or admin)","description":"Non-admin changes are bounded by security limits.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Resources"}}}},"responses":{"200":{"description":"Resources updated"}}}},
    "/api/workspaces/{name}/volumes": {"parameters":[{"$ref":"#/components/parameters/Name"}],"put":{"tags":["Workspaces"],"summary":"Replace shared-volume mounts (owner or admin)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["volumes"],"properties":{"volumes":{"$ref":"#/components/schemas/Names"}}}}}},"responses":{"200":{"description":"Mounts updated"}}}},
    "/api/workspaces/{name}/configurations": {"parameters":[{"$ref":"#/components/parameters/Name"}],"put":{"tags":["Workspaces"],"summary":"Replace private configuration mappings (owner or admin)","description":"Private configurations must belong to the workspace owner; global mappings apply automatically.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["configurations"],"properties":{"configurations":{"type":"array","items":{"$ref":"#/components/schemas/ConfigurationMapping"}}}}}}},"responses":{"200":{"description":"Mappings updated"}}}},
    "/api/workspaces/{name}/token": {"parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Workspaces"],"summary":"Read workspace web login token (owner or admin)","responses":{"200":{"description":"Base64-encoded token","content":{"application/json":{"schema":{"type":"object","properties":{"token_base64":{"type":"string","format":"byte"}}}}}}}},
      "post":{"tags":["Workspaces"],"summary":"Rotate workspace web token (admin only)","description":"Stops the workspace and disconnects sessions. Deploy again after rotation.","responses":{"200":{"description":"Rotated"}}}
    },
    "/api/workspaces/{name}/ports": {"parameters":[{"$ref":"#/components/parameters/Name"}],
      "get":{"tags":["Workspaces"],"summary":"List exposed ports (owner or admin)","responses":{"200":{"description":"Mappings and gateway readiness","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/WorkspacePort"}}}}}}},
      "post":{"tags":["Workspaces"],"summary":"Expose an HTTP, TCP or UDP application (owner or admin)","description":"No Hub authentication is added to exported traffic. All protocols use the workspace hostname and an automatically allocated external port. HTTP uses a dedicated HTTPS listener with the web listener's certificate configuration and a plaintext HTTP backend, leaving the workspace web UI on port 443. Legacy generated-host HTTP mappings migrate automatically when active. Browser cookies are shared across ports of the same hostname: export trusted apps only. Maximum 16 exports per workspace. Built-in ports 2222 and 7317 are reserved. Mappings persist across undeployment. A Kubernetes failure returns 502 but retains the mapping for reconciliation; list before retrying.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","protocol","internal_port"],"properties":{"name":{"$ref":"#/components/schemas/ResourceName"},"protocol":{"type":"string","enum":["HTTP","TCP","UDP"]},"internal_port":{"type":"integer","minimum":1,"maximum":65535}}}}}},"responses":{"201":{"description":"Saved mappings","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/WorkspacePort"}}}}},"409":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/workspaces/{name}/ports/{portName}": {"parameters":[{"$ref":"#/components/parameters/Name"},{"name":"portName","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResourceName"}}],"delete":{"tags":["Workspaces"],"summary":"Remove an exported port (owner or admin)","description":"Removes its Service, route, NetworkPolicy and dedicated listener. Failed cleanup retains the reservation and retries automatically.","responses":{"204":{"description":"Removed"},"404":{"$ref":"#/components/responses/Error"},"502":{"$ref":"#/components/responses/Error"}}}},
    "/api/volumes": {
      "get":{"tags":["Shared volumes"],"summary":"List visible shared volumes","responses":{"200":{"description":"Volumes","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Volume"}}}}}}},
      "post":{"tags":["Shared volumes"],"summary":"Create shared storage","description":"Owner defaults to caller; only admins may specify another owner. Non-admin storage budgets apply.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"$ref":"#/components/schemas/ResourceName"},"owner":{"$ref":"#/components/schemas/AccountName"},"storage_size":{"$ref":"#/components/schemas/StorageSize"},"storage_class":{"type":"string"}}}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Volume"}}}}}}
    },
    "/api/volumes/{name}": {"parameters":[{"$ref":"#/components/parameters/Name"}],"delete":{"tags":["Shared volumes"],"summary":"Delete unmounted volume and PVC (owner or admin)","responses":{"204":{"description":"Deleted"},"409":{"$ref":"#/components/responses/Error"}}}},
    "/api/volumes/{name}/size": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Shared volumes"],"summary":"Expand volume (owner or admin)","requestBody":{"$ref":"#/components/requestBodies/StorageSize"},"responses":{"200":{"description":"Expanded"}}}},
    "/api/volumes/{name}/owner": {"parameters":[{"$ref":"#/components/parameters/Name"}],"patch":{"tags":["Shared volumes"],"summary":"Transfer volume ownership (admin only)","description":"Preserves existing shares, PVC data and workspace mounts. The previous owner retains access through an explicit user share.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["owner"],"properties":{"owner":{"$ref":"#/components/schemas/AccountName"}}}}}},"responses":{"200":{"description":"Owner updated","content":{"application/json":{"schema":{"type":"object","properties":{"owner":{"$ref":"#/components/schemas/AccountName"}}}}}},"400":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"}}}},
    "/api/volumes/{name}/shares": {"parameters":[{"$ref":"#/components/parameters/Name"}],"put":{"tags":["Shared volumes"],"summary":"Replace user/group shares (owner or admin)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"users":{"$ref":"#/components/schemas/Names"},"groups":{"$ref":"#/components/schemas/Names"}}}}}},"responses":{"200":{"description":"Shares updated"},"409":{"$ref":"#/components/responses/Error"}}}},
    "/api/groups": {
      "get":{"tags":["Groups"],"summary":"List visible groups","responses":{"200":{"description":"Groups","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Group"}}}}}}},
      "post":{"tags":["Groups"],"summary":"Create a group","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"$ref":"#/components/schemas/AccountName"},"owner":{"$ref":"#/components/schemas/AccountName"}}}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Group"}}}}}}
    },
    "/api/groups/{name}": {"parameters":[{"name":"name","in":"path","required":true,"schema":{"$ref":"#/components/schemas/AccountName"}}],"delete":{"tags":["Groups"],"summary":"Delete group (owner or admin)","responses":{"204":{"description":"Deleted"},"409":{"$ref":"#/components/responses/Error"}}}},
    "/api/groups/{name}/members": {"parameters":[{"name":"name","in":"path","required":true,"schema":{"$ref":"#/components/schemas/AccountName"}}],"put":{"tags":["Groups"],"summary":"Replace group members (owner or admin)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["members"],"properties":{"members":{"$ref":"#/components/schemas/Names"}}}}}},"responses":{"200":{"description":"Members updated"},"409":{"$ref":"#/components/responses/Error"}}}},
    "/api/configurations": {
      "get":{"tags":["Configurations"],"summary":"List visible configuration metadata","description":"Values are never returned; they live only in Kubernetes.","responses":{"200":{"description":"Configurations","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Configuration"}}}}}}},
      "post":{"tags":["Configurations"],"summary":"Create a ConfigMap or Secret","description":"Global entries are admin-only. Private entries must belong to the workspace owner when mapped.","requestBody":{"$ref":"#/components/requestBodies/Configuration"},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Configuration"}}}}}}
    },
    "/api/configurations/{name}": {"parameters":[{"$ref":"#/components/parameters/Name"}],
      "put":{"tags":["Configurations"],"summary":"Replace configuration values/mappings (owner or admin)","description":"Changes apply to existing mapped workspaces. Global edits require admin.","requestBody":{"$ref":"#/components/requestBodies/Configuration"},"responses":{"200":{"description":"Updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Configuration"}}}}}},
      "delete":{"tags":["Configurations"],"summary":"Delete an unused configuration (owner or admin)","responses":{"204":{"description":"Deleted"},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/directory/{kind}": {"parameters":[{"name":"kind","in":"path","required":true,"schema":{"type":"string","enum":["users","groups"]}},{"name":"q","in":"query","schema":{"type":"string","maxLength":40,"pattern":"^[A-Za-z0-9-]*$"},"description":"Case-insensitive substring; empty returns no results"}],"get":{"tags":["Directory"],"summary":"Search account/group names for sharing","responses":{"200":{"description":"Up to 20 names","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Names"}}}}}}}
  },
  "components": {
    "securitySchemes": {
      "workloadAuth":{"type":"http","scheme":"bearer","description":"Separate scoped hhw_ credential issued through /api/workspaces/{name}/workload-token. No administrator or web tokens accepted. Workload API requires workloads.enabled and an enabled parent budget."},
      "bearerAuth":{"type":"http","scheme":"bearer","description":"Named API token or the existing HUB_API_TOKEN. Enter the token without the Bearer prefix."},
      "sessionAuth":{"type":"apiKey","in":"cookie","name":"__Host-herdr_session","description":"Set by /api/login; local insecure development uses herdr_session instead."}
    },
